{
  "name": "websters-1913-api",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:db && bun run scripts/build-macos-dictionary.ts && next build",
    "build:db": "bun run scripts/build-db.ts",
    "build:db:force": "bun run scripts/build-db.ts --force",
    "build:macos": "bun run build:macos:source && sh scripts/compile-macos-dictionary.sh",
    "build:macos:source": "bun run build:db && bun run scripts/build-macos-dictionary.ts",
    "check": "bun run lint && bun run type-check && bun run format",
    "dev": "next dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix --type-aware .",
    "lint:check": "oxlint --type-aware .",
    "start": "next start",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@phosphor-icons/react": "~2.1.10",
    "better-sqlite3": "13.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@pierre/diffs": "~1.6.4",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "shadcn": "~4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "baseline newly available"
  ]
}
