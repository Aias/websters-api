{
  "name": "websters-1913-api",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:db && next build",
    "build:db": "bun run scripts/build-db.ts",
    "build:db:force": "bun run scripts/build-db.ts --force",
    "check": "bun run lint && bun run type-check && bun run format",
    "dev": "next dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix --type-aware .",
    "lint:check": "oxlint --type-aware .",
    "start": "next start",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
